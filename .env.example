# From Neon: your project → Connect → copy the connection string.
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/neondb?sslmode=require
RESEND_API_KEY='your_resend_api_key_here'
# The sign-up page gives everyone the same reply and finishes by email. Needs RESEND_API_KEY.
SAFE_SIGNUP_REPLY=on
